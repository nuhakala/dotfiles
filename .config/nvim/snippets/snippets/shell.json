{
    "shebang": {
        "prefix": "shebang",
        "body": [
            "#!/usr/bin/env ${1:sh}",
            "#",
            "# ${2:Description of the script.}$0"
        ],
        "description": "Shebang"
    },
    "case": {
        "prefix": "case",
        "body": [
            "case ${1:switch_on} in",
                "\t$2)",
                "\t\t$3",
                "\t\t;;",
                "\t*)",
                "\t\t${4:# Default action}",
                "\t\t;;",
                "esac$0"
        ],
        "description": "Switch case statement"
    },
	"Bash Script with getopt": {
		"prefix": "scripttemplate",
			"body": [
			  "#!/usr/bin/env bash",
			  "",
			  "set -euo pipefail",
			  "",
			  "SCRIPT_DIR=\"\\$(cd \"\\$(dirname \"\\${BASH_SOURCE[0]}\")\" && pwd)\"",
			  "",
			  "usage() {",
			  "    cat <<EOF",
			  "Usage: \\$(basename \"\\$0\") [OPTIONS]",
			  "",
			  "Options:",
			  "  -h, --help    Show this help message",
			  "EOF",
			  "    exit 1",
			  "}",
			  "",
			  "OPTS=\\$(getopt \\\\",
			  "    -o 'h' \\\\",
			  "    --long 'help' \\\\",
			  "    -n \"\\$(basename \"\\$0\")\" -- \"\\$@\") || usage",
			  "if [[ \\$# -eq 0 ]]; then usage; fi",
			  "eval set -- \"\\$OPTS\"",
			  "while true; do",
			  "    case \"\\$1\" in",
			  "        -h|--help) usage ;;",
			  "        --) shift; break ;;",
			  "        *) break ;;",
			  "    esac",
			  "done"
			],
		"description": "Bash script boilerplate with getopt argument parsing, usage function, and SCRIPT_DIR"
  }
}
